const btn = document.querySelector('.btn');
btn.addEventListener('click', moveBox);
let counter = 0;
function moveBox() {
  for (let i = 0; i < 5; i++) {
    counter++;
  }
  const box = document.getElementById('box');
  box.style.left = 100 + counter + 'px';
}

moveBox();
